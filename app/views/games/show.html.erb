<div class="container mt-4">
  <h1>Game Created</h1>

  <p>
    Category:
    <strong><%= @game.category.name %></strong>
  </p>

  <h2>Players</h2>

  <ol>
    <% @game.players.each do |player| %>
      <li><%= player.name %></li>
    <% end %>
  </ol>

  <p>The secret word and imposter have been selected.</p>

  <%= link_to "Set Up Another Game", new_game_path,
      class: "btn btn-primary" %>
</div>